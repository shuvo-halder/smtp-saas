APP_NAME="EmailSaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=103.131.144.61
DB_PORT=3306
DB_DATABASE=smtp
DB_USERNAME=smtp
DB_PASSWORD='Smtp123!'

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Cache & Queue ────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Mail (for notifications from the panel) ──────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Server Config ────────────────────────────────────────────────────────────
MAIL_SERVER_HOST=127.0.0.1
MAIL_VHOSTS_DIR=/var/mail/vhosts
SCRIPTS_DIR=/opt/emailsaas/scripts

# ─── SSLCommerz (Bangladesh Payment) ──────────────────────────────────────────
SSLC_STORE_ID=your_store_id
SSLC_STORE_PASS=your_store_password
SSLC_IS_SANDBOX=false

# ─── Webmail ──────────────────────────────────────────────────────────────────
ROUNDCUBE_URL=https://webmail.yourdomain.com

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ─── Sanctum SPA ──────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=panel.yourdomain.com,localhost:3000
SESSION_DOMAIN=.yourdomain.com
FRONTEND_URL=https://panel.yourdomain.com
