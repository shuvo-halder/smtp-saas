# =============================================================================
# mysql-virtual-forwardings-maps.cf — Postfix MySQL Virtual Forwarding Maps
# =============================================================================
user     = laravel_db_user
password = laravel_db_password
hosts    = 127.0.0.1
dbname   = email_saas_db
query    = SELECT CASE WHEN mailboxes.forwarding_keep_copy = 1 THEN CONCAT(mailboxes.email, ', ', mailboxes.forwarding_destinations) ELSE mailboxes.forwarding_destinations END AS destination FROM mailboxes INNER JOIN domains ON mailboxes.domain_id = domains.id WHERE mailboxes.email = '%s' AND mailboxes.is_forwarding_enabled = 1 AND mailboxes.is_active = 1 AND domains.status = 'active' AND mailboxes.deleted_at IS NULL AND domains.deleted_at IS NULL LIMIT 1
