# Snippet to ensure Dovecot uses the SQL backend
# Typically placed in /etc/dovecot/conf.d/10-auth.conf (include auth-sql.conf.ext)
# Contents of /etc/dovecot/conf.d/auth-sql.conf.ext:

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
