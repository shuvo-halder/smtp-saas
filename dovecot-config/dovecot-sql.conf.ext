# =============================================================================
# dovecot-sql.conf.ext — MySQL Authentication Backend
# Credentials injected by install.sh
# =============================================================================

driver = mysql
connect = host=127.0.0.1 dbname=__DB_NAME__ user=__DB_USER__ password=__DB_PASS__

# Hashing scheme
default_pass_scheme = SHA512-CRYPT

# Password lookup
password_query = \
    SELECT mailboxes.email AS username, mailboxes.password \
    FROM mailboxes \
    INNER JOIN domains ON mailboxes.domain_id = domains.id \
    WHERE mailboxes.email='%u' AND mailboxes.is_active=1 AND domains.status='active' AND domains.deleted_at IS NULL AND mailboxes.deleted_at IS NULL

# User lookup — returns quota_rule and mailbox location
user_query = \
    SELECT \
        CONCAT('/var/vmail/', domains.domain_name, '/', mailboxes.local_part) AS home, \
        5000 AS uid, \
        5000 AS gid, \
        CONCAT('*:bytes=', (mailboxes.quota_mb * 1048576)) AS quota_rule \
    FROM mailboxes \
    INNER JOIN domains ON mailboxes.domain_id = domains.id \
    WHERE mailboxes.email='%u' AND mailboxes.is_active=1 AND domains.status='active' AND domains.deleted_at IS NULL AND mailboxes.deleted_at IS NULL

# Quota update / user iteration
iterate_query = \
    SELECT mailboxes.email AS username \
    FROM mailboxes \
    INNER JOIN domains ON mailboxes.domain_id = domains.id \
    WHERE mailboxes.is_active=1 AND domains.status='active' AND domains.deleted_at IS NULL AND mailboxes.deleted_at IS NULL

