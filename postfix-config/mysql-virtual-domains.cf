# =============================================================================
# mysql-virtual-domains.cf — Virtual Domain Lookup
# Credentials injected by install.sh
# =============================================================================
user     = __DB_USER__
password = __DB_PASS__
hosts    = 127.0.0.1
dbname   = __DB_NAME__
query    = SELECT domain_name FROM domains WHERE domain_name='%s' AND status='active' AND deleted_at IS NULL

