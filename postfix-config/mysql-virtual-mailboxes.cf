# =============================================================================
# mysql-virtual-mailboxes.cf — Virtual Mailbox Lookup
# =============================================================================
user     = __DB_USER__
password = __DB_PASS__
hosts    = 127.0.0.1
dbname   = __DB_NAME__
query    = SELECT CONCAT(domains.domain_name, '/', mailboxes.local_part, '/') FROM mailboxes INNER JOIN domains ON mailboxes.domain_id = domains.id WHERE mailboxes.email='%s' AND mailboxes.is_active=1 AND domains.status='active' AND domains.deleted_at IS NULL AND mailboxes.deleted_at IS NULL

